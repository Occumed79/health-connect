{
  "name": "lilconfig",
  "version": "2.1.0",
  "description": "A zero-dependency alternative to cosmiconfig",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prebuild": "npm run clean",
    "build": "tsc --declaration",
    "postbuild": "du -h ./dist/*",
    "clean": "rm -rf ./dist",
    "test": "jest --coverage",
    "lint": "eslint ./src/*.ts"
  },
  "keywords": [
    "cosmiconfig",
    "config",
    "configuration",
    "search"
  ],
  "files": [
    "dist/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/antonk52/lilconfig"
  },
  "bugs": "https://github.com/antonk52/lilconfig/issues",
  "author": "antonk52",
  "license": "MIT",
  "engines": {
    "node": ">=10"
  }
}
