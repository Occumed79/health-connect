{
  "name": "cssstyle",
  "description": "CSSStyleDeclaration Object Model implementation",
  "keywords": [
    "CSS",
    "CSSStyleDeclaration",
    "StyleSheet"
  ],
  "version": "2.3.0",
  "homepage": "https://github.com/jsdom/cssstyle",
  "maintainers": [
    {
      "name": "Jon Sakas",
      "email": "jon.sakas@gmail.com",
