    "lint": "eslint --fix .",
    "mocha-browser-test": "karma start",
    "mocha-node-test": "mocha",
    "mocha-test": "npm run mocha-node-test && npm run mocha-browser-test",
    "test": "npm run lint && npm run mocha-node-test"
  },
  "license": "MIT",
  "nyc": {
    "exclude": [
      "test"
    ]
  },
  "module": "dist/async.mjs"
