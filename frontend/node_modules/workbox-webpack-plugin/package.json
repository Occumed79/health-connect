{
  "name": "workbox-webpack-plugin",
  "version": "6.6.0",
  "description": "A plugin for your Webpack build process, helping you generate a manifest of local files that workbox-sw should precache.",
  "keywords": [
    "workbox",
    "workboxjs",
    "webpack",
    "service worker",
    "caching",
    "fetch requests",
    "offline",
    "file manifest"
  ],
  "workbox": {
    "packageType": "node_ts"
  },
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "engines": {
    "node": ">=10.0.0"
  },
